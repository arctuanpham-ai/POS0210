{
  "hosting": {
    "site": "pos0210-17ce4",
    "public": "web-dashboard",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "node_modules",
      "test"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
