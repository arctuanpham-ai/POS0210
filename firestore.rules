rules_version = '2';

// Quy tắc Firestore cho POS0210 + web quản lý nhiều tài khoản.
// Dán toàn bộ vào Firebase Console → Firestore Database → Rules → Publish.
// Chủ quán (tài khoản máy POS) giữ nguyên toàn quyền như trước; phần thêm mới chỉ mở cho thành viên chủ quán đã thêm ở trang Tài khoản.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath(owner) { return /databases/$(database)/documents/users/$(owner)/stores/0210/webMembers/$(myEmail()); }
    function member(owner) {
      return signedIn() && request.auth.token.email != null
        && exists(memberPath(owner))
        && get(memberPath(owner)).data.get('active', true) != false;
    }
    function role(owner) { return get(memberPath(owner)).data.role; }
    function treasurer(owner) { return member(owner) && role(owner) == 'THU_QUY'; }
    function buyer(owner) { return member(owner) && role(owner) == 'NGUOI_MUA'; }
    function reimbStatus(data) { return data.get('reimbursement', {}).get('status', 'NONE'); }

    // 1. Chủ quán: toàn quyền như cũ (máy POS và web của chủ quán).
    match /users/{owner}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }

    // 2. Thủ quỹ: đọc/ghi dữ liệu quán, trừ danh sách thành viên (không tự nâng quyền được) và bản sao lưu máy POS.
    match /users/{owner}/stores/{store}/{coll}/{document=**} {
      allow read, write: if store == '0210' && !(coll in ['webMembers', 'privateBackup']) && treasurer(owner);
    }

    // 3. Danh sách thành viên: ai cũng đọc được hồ sơ của mình; thủ quỹ đọc tất cả (để lấy tài khoản ngân hàng tạo QR).
    //    Thành viên chỉ tự sửa tên và tài khoản ngân hàng, không sửa vai trò.
    match /users/{owner}/stores/0210/webMembers/{email} {
      allow read: if member(owner) && (email == myEmail() || role(owner) == 'THU_QUY');
      allow update: if member(owner) && email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bank', 'account', 'holder', 'updatedAt']);
    }

    // 4. Người mua: chỉ phiếu chi của chính mình.
    match /users/{owner}/stores/0210/expenseReceipts/{id} {
      allow read: if buyer(owner) && resource.data.payerEmail == myEmail();
      allow create: if buyer(owner)
        && request.resource.data.payerEmail == myEmail()
        && reimbStatus(request.resource.data) in ['PENDING', 'NONE'];
      // Sửa / huỷ khi chưa hoàn (sửa xong thì về Chờ duyệt, không tự duyệt được);
      // hoặc xác nhận đã nhận tiền (Đã hoàn → Đã nhận, không đổi số tiền).
      allow update: if buyer(owner)
        && resource.data.get('payerEmail', '') == myEmail()
        && request.resource.data.payerEmail == myEmail()
        && (
          (reimbStatus(resource.data) in ['PENDING', 'APPROVED', 'REJECTED', 'NONE', 'UNKNOWN']
            && reimbStatus(request.resource.data) in ['PENDING', 'NONE'])
          || (reimbStatus(resource.data) == 'PAID'
            && reimbStatus(request.resource.data) == 'CONFIRMED'
            && request.resource.data.total == resource.data.total)
        );
    }

    // 5. Người mua: xem các đợt hoàn của mình và bấm "Tôi đã nhận tiền".
    match /users/{owner}/stores/0210/reimbursements/{id} {
      allow read: if buyer(owner) && resource.data.payerEmail == myEmail();
      allow update: if buyer(owner)
        && resource.data.get('payerEmail', '') == myEmail()
        && resource.data.status == 'PAID'
        && request.resource.data.status == 'CONFIRMED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedBy', 'confirmedByEmail']);
    }

    // 6. Người mua: đọc quy tắc phân nhóm vật tư và mốc bắt buộc nhập chi tiết (để form nhập phiếu gợi ý đúng).
    match /users/{owner}/stores/0210/expenseRules/{id} {
      allow read: if buyer(owner);
    }
    match /users/{owner}/stores/0210/config/expenseDetail {
      allow read: if buyer(owner);
    }
  }
}
