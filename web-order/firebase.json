{
  "hosting": {
    "site": "datmon0210",
    "public": "public",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ] },
      { "source": "**/*.@(html|js|css)", "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ] },
      { "source": "/qr", "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ] },
      { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ] },
      { "source": "/assets/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
    ]
  }
}
